# Copia este archivo a .env y rellena los valores

# Ruta absoluta en la NAS donde está la carpeta Trabajos
# En Synology suele ser /volume1/NombreCarpeta
TRABAJOS_PATH=/volume1/OneDriveTC3D/Trabajos

# Contraseña para acceder a la galería (deja vacío para sin contraseña)
GALLERY_PASSWORD=

# Token de Cloudflare Tunnel (obtén uno en dash.cloudflare.com → Zero Trust → Tunnels)
CLOUDFLARE_TOKEN=
